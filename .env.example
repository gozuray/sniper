# Sniper bot - environment variables (optional)
# All bot configuration is in config.toml (see config.example.toml).

# Log file path (default: sniper.log)
# SNIPER_LOG=sniper.log

# Tracing (opcional). Sin RUST_LOG: `warn` fuera del crate + `info` solo en `sniper` (consola limpia).
# Diagnóstico momentum (vol/delta/edge): descomenta una de estas:
# RUST_LOG=sniper::strategy::momentum=trace,sniper=info
# RUST_LOG=sniper=trace
